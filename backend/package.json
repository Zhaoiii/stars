{
  "name": "ba-system-backend",
  "version": "1.0.0",
  "description": "BA System Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "init-db": "ts-node src/scripts/initDatabase.ts",
    "reset-db": "ts-node src/scripts/resetDatabase.ts",
    "migrate": "ts-node src/scripts/migrateDatabase.ts",
    "check-db": "ts-node src/scripts/checkDatabase.ts",
    "init-admin": "ts-node src/scripts/initAdmin.ts",
    "setup": "yarn init-db && yarn init-admin"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "typeorm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
